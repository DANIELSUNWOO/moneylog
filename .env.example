# 이 파일을 복사해 .env 로 만들어 쓴다:  cp .env.example .env
# .env 는 절대 커밋하지 않는다(.gitignore 등록됨).

# --- DB ---
DB_NAME=moneylog
DB_USER=moneylog
DB_PASSWORD=moneylogpw
DB_ROOT_PASSWORD=rootpw

# --- 애플리케이션 ---
# Base64 인코딩된 32바이트 키. 새로 만들려면:  openssl rand -base64 32
JWT_SECRET=changeme-base64-32bytes-key-here=

# 운영에서 스키마가 안정되면 validate 로 내린다.
JPA_DDL_AUTO=update

# --- 배포 ---
# CD가 특정 커밋으로 되돌릴 때 여기에 git sha를 넣는다. 평소에는 latest.
IMAGE_TAG=latest
